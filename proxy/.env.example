# Variables d'environnement — solo-proxy (Render)

POS_PROVIDER=lacaisse

# URL de base export Excel (optionnel)
LACAISSE_BASE_URL=https://api-legacy.lacaisse.ma

# Auth automatique (recommandé) — le champ licence devient token_api
LACAISSE_LOGIN=
LACAISSE_PASSWORD=

# Optionnel : token_api statique (sinon obtenu via login ci-dessus)
# LACAISSE_API_TOKEN=

# Identifiants numériques caisse SOLO PIZZA
LACAISSE_CAISSE_ID=4418
LACAISSE_ID_CAISSE_LIST=4418
LACAISSE_JOURNAL_ID=3

# Frontend autorisé (CORS)
FRONTEND_URL=https://solo-pro.onrender.com

# Avis Google (Places API) — dashboard
# Créez une clé sur Google Cloud avec Places API activée
GOOGLE_PLACES_API_KEY=
# Optionnel : Place ID ChIJ... (sinon recherche auto)
# GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=Solo Pizzeria Napoletana Casablanca

# Dev local uniquement : chemin vers un export Excel sample
# LACAISSE_SAMPLE_FILE=C:\chemin\vers\export.xls
